.row
  .col-xs-12
    .box.box-primary
      .box-header.with-border
        = link_to(node_scripts_path, class: 'btn') do
          = fa('list')
          = I18n.t('actions.index')
        - if @node_script.persisted?
          = link_to(node_script_path(@node_script), class: 'btn') do
            = fa('list-alt')
            = I18n.t('actions.show')
      = semantic_form_for(@node_script) do |form|
        .box-body
          .messages= form.semantic_errors class: 'error-msg'
          = form.input :name
          = form.input :description
          = form.input :variety, as: :select, collection: NodeScript::VARIETIES.map { |v| ["#{v.titleize} Script", v] }, include_blank: 'None', input_html: { class: 'multiselect', disabled: @node_script.persisted? }
          = form.input :enabled, as: :boolean
          - if can?(:manage, NodeScript)
            = form.input :public, as: :boolean
          = form.input :data, input_html: { class: 'codemirror' }
          = form.input :details, input_html: { class: 'markdown' }
        .box-footer
          = render partial: 'layouts/form_actions', locals: { form: form }
