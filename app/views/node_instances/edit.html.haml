.box.box-primary
  = semantic_form_for(@node_instance) do |form|
    .box-body
      .messages= form.semantic_errors class: 'error-msg'
      = form.input :name
      = form.input :description
      = form.input :node_mount_points, label: 'Mount Points', collection: @availabie_node_mount_points, input_html: { class: 'multiselect' }
      - if @node_instance.physical_variety?
        = form.input :address, label: 'Physical Address'
        = form.input :public_ip_address, as: :string, label: 'Public IP'
        = form.input :private_netboot_enabled, as: :boolean
        #private_netboot_settings
          = form.input :private_mac_address, as: :string, label: 'MAC Address'
        = form.input :private_ip_static, as: :boolean, label: 'Static Private IP'
        #private_ip_settings
          = form.input :private_ip_address, as: :string, label: 'Private IP'
          = form.input :private_ip_netmask, as: :string, label: 'Private Subnet Mask'
          = form.input :private_ip_gateway, as: :string, label: 'Private Gateway'
          = form.input :private_ip_device, label: 'Private Network Device'
      = render partial: 'pages/page_form_fields', locals: { f: form }
    .box-footer
      = render partial: 'layouts/form_actions', locals: { f: form }
