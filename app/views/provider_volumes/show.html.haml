.row
  .col-xs-12
    .box.box-primary
      .box-header.with-border
        = link_to(provider_volumes_path, class: 'btn') do
          = fa('list')
          = I18n.t('actions.index')
        - if can?(:update, @provider_volume)
          = link_to(edit_provider_volume_path(@provider_volume), class: 'btn') do
            = fa('edit')
            = I18n.t('actions.edit')
        - if can?(:destroy, @provider_volume)
          .pull-right
            = link_to(@provider_volume, class: 'btn', method: :delete, title: 'Delete', data: { confirm: I18n.t('actions.confirm') }) do
              .text-red
                = fa('remove')
                = I18n.t('actions.destroy')
      .box-body
        - if @provider_volume.details.present?
          .details= find_and_preserve render_markdown(@provider_volume.details)
        %dl.dl-horizontal
          %dt Name
          %dd= @provider_volume.name
          %dt Description
          %dd= @provider_volume.description
          %dt Provider Region
          %dd= @provider_volume.provider_region
          %dt Size
          %dd= number_to_human_size(@provider_volume.actual_size.gigabytes)
          - if @provider_volume.raid?
            %dt RAID Level
            %dd= @provider_volume.raid_level
          %dt Status
          %dd= @provider_volume.status
          - if @provider_volume.node_instance
            %dt Node Instance
            %dd= @provider_volume.node_instance
          - if @provider_volume.node_module
            %dt Node Module
            %dd= @provider_volume.node_module
          - if @provider_volume.provider_volume_members.size > 0
            %dt Volume Members
            %dd
              %ul
                - @provider_volume.provider_volume_members.each do |provider_volume_member|
                  %li= provider_volume_member
          - if @provider_volume.provider_volume_snapshots.size > 0
            %dt Volume Snapshots
            %dd
              %ul
                - @provider_volume.provider_volume_snapshots.each do |provider_volume_snapshot|
                  %li= provider_volume_snapshot
          %dt Created
          %dd= local_time(@provider_volume.created_at)
          %dt Updated
          %dd= local_time(@provider_volume.updated_at)
