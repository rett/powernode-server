.box.box-primary
  .box-header.with-border
    = link_to(provider_network_subnets_path, class: 'btn') do
      = fa('list')
      = I18n.t('actions.index')
    - if can?(:update, @provider_network_subnet)
      = link_to(edit_provider_network_subnet_path(@provider_network_subnet), class: 'btn') do
        = fa('edit')
        = I18n.t('actions.edit')
    - if can?(:destroy, @provider_network_subnet)
      .pull-right
        = link_to(@provider_network_subnet, class: 'btn', method: :delete, title: 'Delete', data: { confirm: I18n.t('actions.confirm') }) do
          .text-red
            = fa('remove')
            = I18n.t('actions.destroy')
  .box-body
    %dl.dl-horizontal
      %dt Name
      %dd= @provider_network_subnet.name
      %dt Description
      %dd= @provider_network_subnet.description
      %dt Network
      %dd= @provider_network_subnet.provider_network
      %dt Availability Zone
      %dd= @provider_network_subnet.provider_availability_zone
      %dt Enabled
      %dd= @provider_network_subnet.enabled? ? 'Yes' : 'No'
      %dt Entity
      %dd= @provider_network_subnet.entity
      %dt Address
      %dd= @provider_network_subnet.network.to_pretty
      %dt Created
      %dd= local_time(@provider_network_subnet.created_at)
      %dt Updated
      %dd= local_time(@provider_network_subnet.updated_at)
= render partial: 'pages/pages', locals: { pages: @provider_network_subnets.pages }
