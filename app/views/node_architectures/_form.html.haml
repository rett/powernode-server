.row
  .col-xs-12
    .box.box-primary
      .box-header.with-border
        = link_to(node_architectures_path, class: 'btn') do
          = fa('list')
          = I18n.t('actions.index')
        = link_to(node_architecture_path(@node_architecture), class: 'btn') do
          = fa('list-alt')
          = I18n.t('actions.show')
      = semantic_form_for(@node_architecture) do |form|
        .box-body
          .messages= form.semantic_errors class: 'error-msg'
          = form.input :name
          = form.input :description
          = form.input :kernel
          = form.input :ramdisk
          = form.input :enabled, as: :boolean
          - if can?(:manage, NodeArchitecture)
            = form.input :public, as: :boolean
          = form.input :details, input_html: { class: 'markdown' }
        .box-footer
          = render partial: 'layouts/form_actions', locals: { form: form }
