.box.box-primary
  .box-header.with-border
    = link_to(users_path, class: 'btn') do
      = fa('list')
      = I18n.t('actions.index')
    - if can?(:update, @user)
      = link_to(edit_user_path(@user), class: 'btn') do
        = fa('edit')
        = I18n.t('actions.edit')
  .box-body
    %dl.dl-horizontal
      %dt Name
      %dd= @user.name
      %dt Email
      %dd= @user.email
      %dt Account delegations
      %dd
        %ul
          - if @user.account_delegations.count > 0
            - @user.account_delegations.each do |account_delegation|
              %li= account_delegation.user.name
          - else
            %li None
      %dt Authorized keys
      %dd
        %ul
          - if @user.authorized_keys.count > 0
            - @user.authorized_keys.each do |authorized_key|
              %li
                - key_type, key_data, key_comment = authorized_key.split(' ')
                %strong #{key_comment}:
                #{key_type}
                - if key_data.size > 20
                  #{key_data.first(10)}...#{key_data.last(10)}
                - else
                  = key_data
          - else
            %li None
      - %w[admin manager publisher].each do |role_type|
        - if @user.send("#{role_type}_roles").size > 0
          %dt #{role_type.titleize} roles
          %dd
            %ul
              - @user.send("#{role_type}_roles").each do |role|
                %li= role.to_s.titleize
      %dt Created
      %dd= local_time(@user.created_at)
      %dt Updated
      %dd= local_time(@user.updated_at)
