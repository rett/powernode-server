.row
  .col-xs-12
    .box.box-primary
      .box-header.with-border
        = link_to(provider_instance_types_path, class: 'btn') do
          = fa('list')
          = I18n.t('actions.index')
        - if @provider_instance_type.persisted?
          = link_to(provider_instance_type_path(@provider_instance_type), class: 'btn') do
            = fa('list-alt')
            = I18n.t('actions.show')
      = semantic_form_for(@provider_instance_type) do |form|
        .box-body
          .messages= form.semantic_errors class: 'error-msg'
          = form.input :name
          = form.input :description
          = form.input :enabled, as: :boolean
          - if can?(:manage, ProviderInstanceType)
            = form.input :public, as: :boolean
          = form.input :details, input_html: { class: 'markdown' }
        .box-footer
          = render partial: 'layouts/form_actions', locals: { form: form }
