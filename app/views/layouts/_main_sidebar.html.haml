- if user_signed_in?
  %aside.main-sidebar
    %section.sidebar
      .user-panel
        .pull-left.image
          = fa('cloud', 'fa-3x')
        .pull-left.info
          %p
            %strong= @current_user.name
          - if @current_account != @current_user.account
            %p= @current_account
      = semantic_navigation :navigation, builder: NavBuilder
