- if user_signed_in?
  %aside.main-sidebar
    %section.sidebar
      .user-panel
        .pull-left.image
          = gravatar_image_tag @current_user.email, filetype: 'png', rating: 'pg', size: 15, secure: false, class: 'user-image img-circle', alt: 'User Image'
        .pull-left.info
          %p= @current_user.name
          %p= @current_account
      = semantic_navigation :navigation, builder: NavBuilder
