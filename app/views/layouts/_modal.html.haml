#mainModal.modal.fade
  .modal-dialog.modal-lg
    .modal-content
      .modal-header
        = link_to(operations_path, remote: true, class: 'close') do
          = fa('refresh', 'refresh-button')
        %h3.modal-title
      .modal-body
        .modal-body-content
          Loading...
      .modal-footer
        %button.btn.btn-primary{ 'data-dismiss' => 'modal' }= I18n.t('actions.close')
