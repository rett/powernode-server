%html
  %head
    %title= [Powernode.config.app_name, yield(:page_title)].compact.join(' ')
    %meta{name: 'viewport', content: 'width=device-width, initial-scale=1'}
    = stylesheet_link_tag 'application'
    = yield(:head)
    = csrf_meta_tags
  - body_classes = []
  - body_classes << 'sidebar-collapse' unless user_signed_in?
  - body_classes << 'fixed' if user_signed_in? && @preferences['fixed_view']
  %body.skin-blue{ class: body_classes, data: { action: params[:action], controller: params[:controller] } }
    .wrapper
      = render partial: 'layouts/main_header'
      = render partial: 'layouts/main_sidebar'
      = render partial: 'layouts/content'
      = render partial: 'layouts/footer'
      = render partial: 'layouts/modal'
      = render partial: 'layouts/control_sidebar'
= javascript_include_tag 'application'
