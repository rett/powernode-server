%h3.control-sidebar-heading
  = I18n.t('settings.general.header')
.form-group
  %label.control-sidebar-subheading
    = I18n.t('settings.general.fixed_view.label')
    .pull-right= link_to !!session[:fixed_view] ? I18n.t('settings.enabled') : I18n.t('settings.disabled'), "?fixed_view=#{!session[:fixed_view]}"
  %p= I18n.t('settings.admin.admin_view.description')
