#node{ data: { id: @node.id} }
.box.box-primary
  .box-header.with-border
    = link_to(nodes_path, class: 'btn') do
      = fa('list')
      = I18n.t('actions.index')
    - if can?(:update, @node)
      = link_to(edit_node_path(@node), class: 'btn') do
        = fa('edit')
        = I18n.t('actions.edit')
    - if can?(:destroy, @node)
      .pull-right
        = link_to(@node, class: 'btn', method: :delete, title: 'Delete', data: { confirm: I18n.t('actions.confirm') }) do
          .text-red
            = fa('remove')
            = I18n.t('actions.destroy')
  .box-body
    = render partial: 'node_details'
.nav-tabs-custom
  %ul.nav.nav-tabs
    %li.active
      = link_to('#node_controls_tab', data: { toggle: 'tab' }) do
        = fa('laptop')
        &nbsp;
        = I18n.t('nodes.show.node_control.header')
    %li
      = link_to('#node_instances_tab', data: { toggle: 'tab' }) do
        = fa('server')
        &nbsp;
        = I18n.t('nodes.show.node_instances.header')
    %li
      = link_to('#node_modules_tab', data: { toggle: 'tab' }) do
        = fa('sitemap')
        &nbsp;
        = I18n.t('nodes.show.node_modules.header')
  .tab-content
    .tab-pane#node_controls_tab.active= render partial: 'node_controls_tab'
    .tab-pane#node_instances_tab= render partial: 'node_instances_tab', locals: { node: @node, node_instances: @node.node_instances }
    .tab-pane#node_modules_tab= render partial: 'node_modules_tab', locals: { node: @node, node_modules: @available_node_modules }
= render partial: 'pages/pages', locals: { pages: @node.pages }
