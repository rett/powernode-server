- @available_node_module_categories.sort_by(&:priority).each do |category|
  - if @node.node_template.node_modules.where(node_module_category: category).enabled.size > 0
    - if category.description.present?
      %legend #{category.name}: #{category.description}
    - else
      %legend= category.name
    .box-group{ id: "accordion_#{category.id}" }
      .panel.box.box-solid.box-primary
        - node_modules.where(node_module_category: category).sort_by(&:effective_priority).each do |node_module|
          .box-header.with-border
            %h4.box-title
              %a{ data: { toggle: 'collapse', parent: "#accordion_#{category.id}" }, id: node_module.id, class: @node.node_modules.include?(node_module) ? 'underline' : '', href: "#collapse_#{node_module.id}" }= node_module.description.present? ? "#{node_module.name}: #{node_module.description}" : node_module.name
          .panel-collapse.collapse{ id: "collapse_#{node_module.id}" }
            .box-body
              .pull-right
                = refresh_button(:node_modules, node_module_id: node_module.id) do
                  = fa('refresh', 'refresh-button')
              = render partial: 'node_module', locals: { node_module: node_module }
