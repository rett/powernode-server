.box.box-default
  .box-header.with-border
    = I18n.t('nodes.control_node.instance_control.header')
  - if node_instance.physical_variety?
    .box-body
      .btn-group
        - Powernode.config.image_formats.each do |f|
          = control_node_button(:instance_create_image, options: { image_format: f, node_instance_id: node_instance.id }, html_options: { class: 'btn btn-default', data: { confirm: I18n.t('actions.confirm') } }, label: I18n.t('nodes.control_node.instance_create_image.label', image_format: f.upcase))
      .pull-right
        .btn-group
          = control_node_button(:instance_reset_key, icon: 'exclamation-triangle', options: { node_instance_id: node_instance.id }, html_options: { class: 'btn btn-danger', data: { confirm: I18n.t('actions.confirm') } })
          = control_node_button(:instance_destroy, icon: 'times-circle', label: I18n.t('actions.destroy'), options: { node_instance_id: node_instance.id }, html_options: { class: 'btn btn-danger', data: { confirm: I18n.t('actions.confirm') } })
  - else
    .box-body
      - case node_instance.status
        - when 'error', 'pending', 'reboot'
          .btn-group
            = control_node_button(:instance_terminate, icon: 'times-circle', label: I18n.t('actions.terminate'), options: { node_instance_id: node_instance.id }, html_options: { class: 'btn btn-danger', data: { confirm: I18n.t('actions.confirm') } })
        - when 'active', 'running'
          .btn-group
            = control_node_button(:instance_cleanse, icon: 'recycle', label: I18n.t('actions.cleanse'), options: { node_instance_id: node_instance.id }, html_options: { class: 'btn btn-default', data: { confirm: I18n.t('actions.confirm') } })
            = control_node_button(:instance_sync, icon: 'refresh', label: I18n.t('actions.sync'), options: { node_instance_id: node_instance.id }, html_options: { class: 'btn btn-default', data: { confirm: I18n.t('actions.confirm') } })
          .pull-right
            .btn-group
              = control_node_button(:instance_reboot, icon: 'exclamation-triangle', label: I18n.t('actions.reboot'), options: { node_instance_id: node_instance.id }, html_options: { class: 'btn btn-warning', data: { confirm: I18n.t('actions.confirm') } })
              = control_node_button(:instance_stop, icon: 'power-off', label: I18n.t('actions.stop'), options: { node_instance_id: node_instance.id }, html_options: { class: 'btn btn-danger', data: { confirm: I18n.t('actions.confirm') } })
              = control_node_button(:instance_terminate, icon: 'times-circle', label: I18n.t('actions.terminate'), options: { node_instance_id: node_instance.id }, html_options: { class: 'btn btn-danger', data: { confirm: I18n.t('actions.confirm') } })
        - when 'shutoff', 'stopped'
          .pull-right
            .btn-group
              = control_node_button(:instance_start, icon: 'power-off', label: I18n.t('actions.start'), options: { node_instance_id: node_instance.id }, html_options: { class: 'btn btn-default', data: { confirm: I18n.t('actions.confirm') } })
              = control_node_button(:instance_terminate, icon: 'times', label: I18n.t('actions.terminate'), options: { node_instance_id: node_instance.id }, html_options: { class: 'btn btn-danger', data: { confirm: I18n.t('actions.confirm') } })

