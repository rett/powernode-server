.box.box-primary
  .box-header.with-border
    = link_to(provider_volume_types_path, class: 'btn') do
      = fa('list')
      = I18n.t('actions.index')
    - if can?(:update, @provider_volume_type)
      = link_to(edit_provider_volume_type_path(@provider_volume_type), class: 'btn') do
        = fa('edit')
        = I18n.t('actions.edit')
    - if can?(:destroy, @provider_volume_type)
      .pull-right
        = link_to(@provider_volume_type, class: 'btn', method: :delete, title: 'Delete', data: { confirm: I18n.t('actions.confirm') }) do
          .text-red
            = fa('remove')
            = I18n.t('actions.destroy')
  .box-body
    %dl.dl-horizontal
      %dt Name
      %dd= @provider_volume_type.name
      %dt Description
      %dd= @provider_volume_type.description
      %dt Mount script
      %dd= @provider_volume_type.mount_script
      %dt Created
      %dd= local_time(@provider_volume_type.created_at)
      %dt Updated
      %dd= local_time(@provider_volume_type.updated_at)
= render partial: 'pages/pages', locals: { pages: @provider_volume_type.pages }
