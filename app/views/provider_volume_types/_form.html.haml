.row
  .col-xs-12
    .box.box-primary
      = semantic_form_for(@provider_volume_type) do |form|
        .box-body
          .messages= form.semantic_errors class: 'error-msg'
          = form.input :name
          = form.input :description
          = form.input :mount_script, as: :select, collection: @available_mount_scripts, include_blank: 'None', input_html: { class: 'multiselect' }
          - if can?(:manage, ProviderVolumeType)
            = form.input :public, as: :boolean
          = form.input :details, input_html: { class: 'markdown' }
        .box-footer
          = render partial: 'layouts/form_actions', locals: { form: form }
