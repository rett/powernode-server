.row
  .col-xs-12
    .box.box-primary
      = semantic_form_for @account do |form|
        .box-body
          = form.input :plan_id, as: :select, collection: @plans, disabled: lambda { |p| !@account.qualifies_for?(p) }, include_blank: 'None', input_html: { class: 'multiselect' }
          -#= form.select(:plan_id, options_from_collection_for_select(@plans, :id, :name, disabled: lambda { |p| !@account.qualifies_for?(p) }, selected: @account.plan_id), class: 'multiselect', id: 'plan')
        .box-footer
          = render partial: 'layouts/form_actions', locals: { form: form }
