.row
  .col-xs-12
    .box.box-primary
      = semantic_form_for(@account) do |form|
        .box-body
          .messages= form.semantic_errors class: 'error-msg'
          = hidden_field_tag :plan, params[:plan]
          = form.input :name
          - if can?(:manage, Account)
            = form.input :agent, as: :select, collection: @available_agents, include_blank: 'None', input_html: { class: 'multiselect' }
        .box-footer
          = render partial: 'layouts/form_actions', locals: { form: form }
.row
  .col-xs-12
    %h3= I18n.t('accounts.delegations.header')
    .box.box-primary
      .box-body
        %table.table
          %thead
            %th User Email
            %th Expiration
            %th Action
          %tbody#account_delegation_list
            %tr
              = form_tag(delegation_account_path, as: :javascript, remote: true, data: { confirm: I18n.t('actions.confirm') }) do
                = hidden_field_tag :account_id, @account.id
                %td= text_field_tag :email, '', class: 'form-control', size: 40
                %td
                  = datetime_field_tag :expiration, '', class: 'form-control', size: 40
                  = link_to I18n.t('actions.never'), '#', onclick: '$("#expiration").val(null); return false'
                %td= submit_tag('Add')
            - @account.account_delegations.each do |delegation|
              - @delegation = delegation
              = render partial: 'delegation'
