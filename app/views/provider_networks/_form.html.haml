.row
  .col-xs-12
    .box.box-primary
      .box-header.with-border
        = link_to(provider_networks_path, class: 'btn') do
          = fa('list')
          = I18n.t('actions.index')
        - if @provider_network.persisted?
          = link_to(provider_network_path(@provider_network), class: 'btn') do
            = fa('list-alt')
            = I18n.t('actions.show')
      = semantic_form_for(@provider_network) do |form|
        .box-body
          .messages= form.semantic_errors class: 'error-msg'
          = form.input :name
          = form.input :description
          = form.input :provider_region, collection: @available_provider_regions, include_blank: 'None', input_html: { class: 'multiselect' }
          = form.input :enabled, as: :boolean
          = form.input :entity
          = form.input :dns1, label: 'DNS 1'
          = form.input :dns2, label: 'DNS 2'
          = form.input :network, as: :string, input_html: { disabled: @provider_network.persisted? }
          = form.input :details, input_html: { class: 'markdown' }
        .box-footer
          = render partial: 'layouts/form_actions', locals: { form: form }
