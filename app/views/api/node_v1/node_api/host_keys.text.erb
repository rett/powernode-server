#!/bin/sh
. /etc/identity.cfg
. /etc/node.cfg
echo "Updating SSH host keys..."
mkdir -p "${UNION}/etc/ssh"
rm -f ${UNION}/etc/ssh/ssh_host_*_key*
echo -e "<%= OpenSSL::PKey::RSA.new(@node.ssh_host_key).to_pem %>"     > "${UNION}/etc/ssh/ssh_host_rsa_key"
echo -e "<%= OpenSSL::PKey::RSA.new(@node.ssh_host_key).public_key %>" > "${UNION}/etc/ssh/ssh_host_rsa_key.pub"
chmod go-rw ${UNION}/etc/ssh/ssh_host_*_key
