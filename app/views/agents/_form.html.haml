.row
  .col-xs-12
    .box.box-primary
      = semantic_form_for(@agent) do |form|
        .box-body
          .messages= form.semantic_errors class: 'error-msg'
          = form.input :name
          = form.input :description
          = form.input :proxy_url
          = form.input :key, as: :password, required: @agent.new_record?
          = form.input :key_confirmation, as: :password, required: @agent.new_record?
          = form.input :enabled, as: :boolean
          - if can?(:manage, Agent)
            = form.input :primary, as: :boolean
            = form.input :public, as: :boolean
          = form.input :details, input_html: { class: 'markdown' }
        .box-footer
          = render partial: 'layouts/form_actions', locals: { form: form }
