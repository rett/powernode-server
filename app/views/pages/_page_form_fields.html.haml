%h3= I18n.t('pages.header')
#pages
  = f.fields_for :pages do |page|
    = render partial: 'pages/page_fields', locals: { f: page }
.links
  = link_to_add_association I18n.t('actions.add'), f, :pages, class: 'btn btn-primary', data: { 'association-insertion-method' => 'before' }, partial: 'pages/page_fields'
