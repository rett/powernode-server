.box.box-primary
  .box-header.with-border
    - if can?(:create, Page)
      = link_to({ action: 'new' }, class: 'btn') do
        = fa('plus-square-o')
        = I18n.t('actions.new')
    .box-tools
      .has_feedback
        = search_form_for @search do |form|
          = form.text_field :name_or_title_cont, class: 'form-control', placeholder: 'Search'
          %i.glyphicon.glyphicon-search.form-control-feedback
  .box-body
    %table.table.table-bordered.table-striped
      %thead
        %th= sort_link @search, :pageable_type, 'Item'
        %th= sort_link @search, :name
        %th= sort_link @search, :title
      %tbody
        = render @pages
  .box-footer
    = will_paginate renderer: BootstrapPagination::Rails, class: 'pagination pagination-sm no-margin'
