.row
  .col-xs-12
    .box.box-primary
      .box-header.with-border
        = link_to(pages_path, class: 'btn') do
          = fa('list')
          = I18n.t('actions.index')
        = link_to(page_path(@page), class: 'btn') do
          = fa('list-alt')
          = I18n.t('actions.show')
      = semantic_form_for(@page) do |form|
        .box-body
          .messages= form.semantic_errors class: 'error-msg'
          = form.input :name
          = form.input :title
          = form.input :enabled, as: :boolean
          = form.input :public, as: :boolean
          = form.text_area :content, class: 'markdown'
        .box-footer
          = render partial: 'layouts/form_actions', locals: { form: form }
