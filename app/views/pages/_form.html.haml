.box.box-primary
  .box-header.with-border
    = link_to(pages_path, class: 'btn') do
      = fa('list')
      = I18n.t('actions.index')
    - if @page.persisted?
      = link_to(page_path(@page), class: 'btn') do
        = fa('list-alt')
        = I18n.t('actions.show')
  = semantic_form_for(@page) do |form|
    .box-body
      .messages= form.semantic_errors class: 'error-msg'
      = form.input :name
      = form.input :title
      = form.input :enabled, as: :boolean
      = form.input :public, as: :boolean
      = form.text_area :content, class: 'markdown'

      -#= render partial: 'page_resources', locals: { form: form }

      %h3= I18n.t('pages.resources.header')
      #page_resources
        = form.fields_for :page_resources, @page.page_resources do |f|
          = render partial: 'page_resource_fields', locals: { f: f }
      .links
        = link_to_add_association I18n.t('actions.add'), form, :page_resources, class: 'btn btn-primary', data: { 'association-insertion-method' => 'before' }

    .box-footer
      = render partial: 'layouts/form_actions', locals: { f: form }
