.row
  .col-xs-12
    .box.box-primary
      .box-header.with-border
        = link_to(node_platforms_path, class: 'btn') do
          = fa('list')
          = I18n.t('actions.index')
        - if can?(:update, @node_platform)
          = link_to(edit_node_platform_path(@node_platform), class: 'btn') do
            = fa('edit')
            = I18n.t('actions.edit')
        - if can?(:destroy, @node_platform)
          .pull-right
            = link_to(@node_platform, class: 'btn', method: :delete, title: 'Delete', data: { confirm: I18n.t('actions.confirm') }) do
              .text-red
                = fa('remove')
                = I18n.t('actions.destroy')
      .box-body
        - if @node_platform.details.present?
          .details= find_and_preserve render_markdown(@node_platform.details)
        %dl.dl-horizontal
          %dt Name
          %dd= @node_platform.name
          %dt Description
          %dd= @node_platform.description
          %dt Enabled
          %dd= @node_platform.enabled? ? 'Yes' : 'No'
          %dt Architecture
          %dd= @node_platform.node_architecture
          %dt Build Script
          %dd= @node_platform.build_script
          %dt Init Script
          %dd= @node_platform.init_script
          %dt Sync Script
          %dd= @node_platform.sync_script
          %dt Created
          %dd= local_time(@node_platform.created_at)
          %dt Updated
          %dd= local_time(@node_platform.updated_at)
