.row
  .col-xs-12
    .box.box-primary
      .box-header.with-border
        = link_to(provider_regions_path, class: 'btn') do
          = fa('list')
          = I18n.t('actions.index')
        = link_to(provider_region_path(@provider_region), class: 'btn') do
          = fa('list-alt')
          = I18n.t('actions.show')
      = semantic_form_for(@provider_region) do |form|
        .box-body
          .messages= form.semantic_errors class: 'error-msg'
          = form.input :name
          = form.input :description
          = form.input :provider_id, label: 'Provider', as: :select, collection: @available_providers.map { |e| [e.description, e.id] }, include_blank: 'None', input_html: { class: 'multiselect' }
          = form.input :provider_instance_types, label: 'Instance Types', collection: @available_provider_instance_types, input_html: { class: 'multiselect' }
          = form.input :provider_volume_types, label: 'Volume Types', collection: @available_volume_types, input_html: { class: 'multiselect' }
          = form.input :endpoint_url
          = form.input :machine_image
          = form.input :kernel_image
          = form.input :ramdisk_image
          = form.input :region
          = form.input :enabled, as: :boolean
          - if can?(:manage, ProviderRegion)
            = form.input :public, as: :boolean
          = form.input :details, input_html: { class: 'markdown' }
        .box-footer
          = render partial: 'layouts/form_actions', locals: { form: form }
