.box.box-primary
  .box-header.with-border
    = link_to(node_mount_points_path, class: 'btn') do
      = fa('list')
      = I18n.t('actions.index')
    - if can?(:update, @node_mount_point)
      = link_to(edit_node_mount_point_path(@node_mount_point), class: 'btn') do
        = fa('edit')
        = I18n.t('actions.edit')
    - if can?(:destroy, @node_mount_point)
      .pull-right
        = link_to(@node_mount_point, class: 'btn', method: :delete, title: 'Delete', data: { confirm: I18n.t('actions.confirm') }) do
          .text-red
            = fa('remove')
            = I18n.t('actions.destroy')
  .box-body
    %dl.dl-horizontal
      %dt Name
      %dd= @node_mount_point.name
      %dt Description
      %dd= @node_mount_point.description
      %dt Device
      %dd= @node_mount_point.device
      %dt Path
      %dd= @node_mount_point.path
      %dt Parameters
      %dd= @node_mount_point.parameters
      %dt Mount Script
      %dd= @node_mount_point.mount_script
      %dt Node Module
      %dd= @node_mount_point.node_module
      %dt Enabled
      %dd= @node_mount_point.enabled? ? 'Yes' : 'No'
      %dt Public
      %dd= @node_mount_point.public? ? 'Yes' : 'No'
      %dt Dependency
      %dd= @node_mount_point.node_mount_point_dependency
      %dt Created
      %dd= local_time(@node_mount_point.created_at)
      %dt Updated
      %dd= local_time(@node_mount_point.updated_at)
= render partial: 'pages/pages', locals: { pages: @node_mount_point.pages }
