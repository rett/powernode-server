.box.box-primary
  .box-header.with-border
    = link_to(provider_connections_path, class: 'btn') do
      = fa('list')
      = I18n.t('actions.index')
    - if can?(:update, @provider_connection)
      = link_to(edit_provider_connection_path(@provider_connection), class: 'btn') do
        = fa('edit')
        = I18n.t('actions.edit')
    - if can?(:destroy, @provider_connection)
      .pull-right
        = link_to(@provider_connection, class: 'btn', method: :delete, title: 'Delete', data: { confirm: I18n.t('actions.confirm') }) do
          .text-red
            = fa('remove')
            = I18n.t('actions.destroy')
  .box-body
    %dl.dl-horizontal
      %dt Name
      %dd= @provider_connection.name
      %dt Description
      %dd= @provider_connection.description
      %dt Provider
      %dd= @provider_connection.provider
      %dt Enabled
      %dd= @provider_connection.enabled? ? 'Yes' : 'No'
      - if @provider_connection.tenant.present?
        %dt Tenant
        %dd= @provider_connection.tenant
      %dt Created
      %dd= local_time(@provider_connection.created_at)
      %dt Updated
      %dd= local_time(@provider_connection.updated_at)
= render partial: 'pages/pages', locals: { pages: @provider_connection.pages }
