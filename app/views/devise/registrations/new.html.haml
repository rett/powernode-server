.register-box
  .register-logo
    Node
    %b Alchemy
  .register-box-body
    - if @plan && @plan.details.present?
      %p.login-box-msg
        .details= find_and_preserve render_markdown(@plan.details)
    = semantic_form_for(@user, url: registration_path(@user)) do |form|
      .messages= form.semantic_errors class: 'error-msg'
      = form.input :plan_id, as: :hidden, input_html: { value: session[:plan_id] }
      = form.input :invitation_id, as: :hidden, input_html: { value: session[:invitation_id] }
      = form.input :name, append: glyph('user'), label: false
      = form.input :email, append: glyph('envelope'), label: false
      = form.input :password, append: glyph('lock'), label: false
      = form.input :password_confirmation, append: glyph('lock'), label: false
      .row
        .col-xs-8
          = check_box_tag :accept_terms
          &nbsp;
          I agree to the #{link_to 'terms', page_path('terms')}
        .col-xs-4
          = form.submit 'Register', class: 'btn btn-primary btn-block btn-flat'
    .row
      .col-xs-12
        = link_to 'Already have an account', new_user_session_path
    .row
      .col-xs-12
        = render 'devise/shared/links'
