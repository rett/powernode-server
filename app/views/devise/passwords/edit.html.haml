.login-box
  .login-logo
    Node
    %b Alchemy
  .login-box-body
    %h3.login-box-msg
      = I18n.t('sessions.header.edit')
    = semantic_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |form|
      .form-group.has-feedback
        = devise_error_messages!
        = form.hidden_field :reset_password_token, as: :hidden
        = form.input :password, autofocus: true, label: false
        = form.input :password_confirmation
        .row
          .col-xs-8
            &nbsp;
          .col-xs-4
            = form.submit 'Send', class: 'btn btn-primary btn-block btn-flat'
    = render partial: 'devise/shared/links'
