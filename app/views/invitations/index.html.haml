.row
  .col-xs-12
    .box.box-primary
      .box-header.with-border
        - if can?(:create, Invitation)
          = link_to({ action: 'new' }, class: 'btn') do
            = fa('plus-square-o')
            = I18n.t('actions.new')
        .box-tools
          .has_feedback
            = search_form_for @search do |form|
              = form.text_field :recipient_cont, class: 'form-control input-sm', placeholder: 'Search'
              = content_tag :div, '', class: 'glyphicon glyphicon-search form-control-feedback'
      .box-body
        %table.table.table-bordered.table-striped
          %thead
            %th= sort_link @search, :recipient
            %th= sort_link @search, :updated_at
          %tbody
            = render @invitations
      .box-footer
        = will_paginate renderer: BootstrapPagination::Rails, class: 'pagination pagination-sm no-margin'
