.row
  .col-xs-12
    .box.box-primary
      .box-header.with-border
        = link_to(invitations_path, class: 'btn') do
          = fa('list')
          = I18n.t('actions.index')
        - if can?(:update, @invitation)
          = link_to(edit_invitation_path(@invitation), class: 'btn') do
            = fa('edit')
            = I18n.t('actions.edit')
        - if can?(:destroy, @invitation)
          .pull-right
            = link_to(@invitation, class: 'btn', method: :delete, title: 'Delete', data: { confirm: I18n.t('actions.confirm') }) do
              .text-red
                = fa('remove')
                = I18n.t('actions.destroy')
      .box-body
        %dl.dl-horizontal
          %dt Recipient
          %dd= @invitation.recipient.present? ? @invitation.recipient : 'Anonymous'
          %dt Updated
          %dd= local_time(@invitation.updated_at)
