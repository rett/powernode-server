.row
  .col-xs-12
    .box.box-primary
      .box-header.with-border
        = link_to(invitations_path, class: 'btn') do
          = fa('list')
          = I18n.t('actions.index')
        - if @invitation.persisted?
          = link_to(invitation_path(@invitation), class: 'btn') do
            = fa('list-alt')
            = I18n.t('actions.show')
      = semantic_form_for(@invitation) do |form|
        .box-body
          .messages= form.semantic_errors class: 'error-msg'
          = form.input :recipient, label: 'Recipient email'
        .box-footer
          = render partial: 'layouts/form_actions', locals: { form: form }
