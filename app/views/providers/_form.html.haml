.row
  .col-xs-12
    .box.box-primary
      .box-header.with-border
        = link_to(providers_path, class: 'btn') do
          = fa('list')
          = I18n.t('actions.index')
        - if @provider.persisted?
          = link_to(provider_path(@provider), class: 'btn') do
            = fa('list-alt')
            = I18n.t('actions.show')
      = semantic_form_for(@provider) do |form|
        .box-body
          .messages= form.semantic_errors class: 'error-msg'
          = form.input :name
          = form.input :description
          = form.input :variety, as: :select, collection: Provider::VARIETIES.map { |v| [v.titleize, v] }, include_blank: 'None', input_html: { disabled: @provider.persisted?, class: 'multiselect' }
          = form.input :enabled, as: :boolean
          - if can?(:manage, Provider)
            = form.input :public, as: :boolean
          = form.input :details, input_html: { class: 'markdown' }
        .box-footer
          = render partial: 'layouts/form_actions', locals: { form: form }
