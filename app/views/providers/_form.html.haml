.row
  .col-xs-12
    .box.box-primary
      = semantic_form_for(@provider) do |form|
        .box-body
          .messages= form.semantic_errors class: 'error-msg'
          = form.input :name
          = form.input :description
          = form.input :variety, as: :select, collection: Provider::VARIETIES.map { |v| [v.titleize, v] }, input_html: { disabled: @provider.persisted?, class: 'multiselect' }
          = form.input :enabled, as: :boolean
          - if can?(:manage, Provider)
            = form.input :public, as: :boolean
          = form.input :details, input_html: { class: 'markdown' }
        .box-footer
          = render partial: 'layouts/form_actions', locals: { form: form }
