.row
  .col-xs-12
    .box.box-primary
      .box-header.with-border
        - if can?(:create, NodeModuleCopyPath)
          = link_to({ action: 'new' }, class: 'btn') do
            = fa('plus-square-o')
            = I18n.t('actions.new')
        .box-tools
          .has_feedback
            = search_form_for @search do |form|
              = form.text_field :name_or_description_cont, class: 'form-control input-sm', placeholder: 'Search'
              %i.glyphicon.glyphicon-search.form-control-feedback
      .box-body
        %table.table.table-bordered.table-striped
          %thead
            %th= sort_link @search, :name
            %th= sort_link @search, :node_platform_name, 'Platform'
            %th= sort_link @search, :node_module_category_name, 'Category'
          %tbody
            = render @node_modules
      .box-footer
        = will_paginate renderer: BootstrapPagination::Rails, class: 'pagination pagination-sm no-margin'
