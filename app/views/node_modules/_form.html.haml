.box.box-primary
  .box-header.with-border
    = link_to(node_modules_path, class: 'btn') do
      = fa('list')
      = I18n.t('actions.index')
    - if @node_module.persisted?
      = link_to(node_module_path(@node_module), class: 'btn') do
        = fa('list-alt')
        = I18n.t('actions.show')
  = semantic_form_for(@node_module) do |form|
    .box-body
      .messages= form.semantic_errors class: 'error-msg'
      = form.input :name, input_html: { value: @node_module.name, disabled: @node_module.node_module_subscription ? true : false }
      = form.input :description
      - if can?(:manage, NodeModule)
        = form.input :data
      - unless @node_module.parent_module
        - if can?(:manage, NodeModule)
          = form.input :public, as: :boolean
        = form.input :enabled, as: :boolean
        = form.input :custom_build_script, as: :boolean
        #build_script= form.input :build_script, collection: @available_build_scripts, include_blank: 'None', input_html: { class: 'multiselect' }
        = form.input :init_restart
        = form.input :init_start
        = form.input :init_stop
        = form.input :node_platform, collection: @available_node_platforms, include_blank: 'None', input_html: { class: 'multiselect' }
        = form.input :dependant_modules, as: :select, label: 'Dependencies', collection: @available_node_modules, input_html: { class: 'multiselect' }
        = form.input :node_templates, collection: @available_node_templates, input_html: { class: 'multiselect' }
        = form.input :node_module_category, collection: options_for_select(@available_node_module_categories.subscription_variety.map  { |c| [c.name, c.id] }, @node_module.node_module_category_id), include_blank: 'None', input_html: { class: 'multiselect' }
        = form.input :puppet_modules, collection: @available_puppet_modules, input_html: { class: 'multiselect' }
        = form.input :priority, as: :select, collection: Powernode.config.module_priority_range[0]..Powernode.config.module_priority_range[1], include_blank: 'None', input_html: { class: 'multiselect' }
        = form.input :immutable, as: :boolean
        = form.input :required, as: :boolean
        = form.input :reboot_required, as: :boolean
        = form.input :provisional, as: :boolean
        = form.input :configurable, as: :boolean
        - if !@node_module.persisted? || @node_module.subscription_variety?
          = form.input :lock_spec, as: :boolean
          = form.inputs :node_module_spec do
            = form.input :package_spec, input_html: { value: @node_module.package_spec_text, rows: 20 }
            = form.input :file_spec, input_html: { value: @node_module.file_spec_text, rows: 20 }
            #dependency_spec= form.input :dependency_spec, as: 'text', input_html: { value: @node_module.dependency_spec ? @node_module.dependency_spec_text : nil, rows: 20 }
            = form.input :mask, input_html: { value: @node_module.mask_text, rows: 20 }
      = render partial: 'pages/page_form_fields', locals: { f: form }
    .box-footer
      = render partial: 'layouts/form_actions', locals: { f: form }
