#node_module{ data: { id: @node_module.id} }
.row
  .col-xs-12
    .box.box-primary
      .box-header.with-border
        = link_to(node_modules_path, class: 'btn') do
          = fa('list')
          = I18n.t('actions.index')
        - if can?(:update, @node_module)
          = link_to(edit_node_module_path(@node_module), class: 'btn') do
            = fa('edit')
            = I18n.t('actions.edit')
        - if can?(:destroy, @node_module)
          .pull-right
            = link_to(@node_module, class: 'btn', method: :delete, title: 'Delete', data: { confirm: I18n.t('actions.confirm') }) do
              .text-red
                = fa('remove')
                = I18n.t('actions.destroy')
      .box-body
        - if @node_module.details.present?
          .details= find_and_preserve render_markdown(@node_module.details)
        %dl.dl-horizontal
          %dt Name
          %dd= @node_module.name
          %dt Description
          %dd= @node_module.description
          %dt Platform
          %dd= @node_module.node_platform.name
          %dt Category
          %dd= @node_module.node_module_category.name
          %dt Enabled
          %dd= @node_module.enabled? ? 'Yes' : 'No'
          - if @node_module.public?
            %dt Public
            %dd Yes
          %dt Build Script
          %dd= @node_module.build_script
          %dt Configurable
          %dd= @node_module.configurable? ? 'Yes' : 'No'
          %dt Provisional
          %dd= @node_module.provisional? ? 'Yes' : 'No'
          %dt Immutable
          %dd= @node_module.immutable? ? 'Yes' : 'No'
          %dt Required
          %dd= @node_module.required? ? 'Yes' : 'No'
          %dt Reboot Required
          %dd= @node_module.reboot_required? ? 'Yes' : 'No'
          %dt Lock spec
          %dd= @node_module.lock_spec? ? 'Yes' : 'No'
          %dt Priority
          %dd= @node_module.priority
          %dt Version
          %dd= @node_module.version
          %dt File Name
          %dd
            - if can?(:manage, NodeModule) && @node_module.data_checksum.present?
              = link_to @node_module.data_file_name, download_node_module_url(@node_module)
            - else
              = @node_module.data_file_name
          %dt File Size
          %dd= number_to_human_size(@node_module.data.size)
          %dt Checksum
          %dd= @node_module.data_checksum
          - if @node_module.node_templates
            %dt Node Templates
            %dd
              %ul
                - @node_module.node_templates.each do |node_template|
                  %li= node_template.name
          - if @node_module.puppet_modules.count > 0
            %dt Puppet Modules
            %dd
              %ul
                - @node_module.puppet_modules.each do |puppet_module|
                  %li= puppet_module
          - if @node_module.dependant_modules.count > 0
            %dt Dependencies
            %dd
              %ul
                - @node_module.dependant_modules.each do |dependant_module|
                  %li= dependant_module
          %dt Created
          %dd= local_time(@node_module.created_at)
          %dt Updated
          %dd= local_time(@node_module.updated_at)
          %dt Dependency Tree:
          %dd
            %svg#dependency_tree{width: '800', height: '400', viewBox: '0 0 800 400', preserveAspectRatio: 'xMidYMid'}
