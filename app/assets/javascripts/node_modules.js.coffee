$(document).bind 'edit_node_modules.load', (e, obj) =>
  if $("input#node_module_custom_build_script").prop("checked") == false
    $("#build_script").hide()
    $("#node_module_build_script_id").multiselect("disable")
  $("input#node_module_custom_build_script")
    .change ->
      if $("input#node_module_custom_build_script").prop("checked") == false
        $("#build_script").slideUp()
        $("#node_module_build_script_id").multiselect("disable")
      if $("input#node_module_custom_build_script").prop("checked") == true
        $("#build_script").slideDown()
        $("#node_module_build_script_id").multiselect("enable")
  $("#node_module_node_platform_id")
    .change ->
      node_platform = $("select#node_module_node_platform_id :selected").val()
      update_platform_items_url = $("form.node_module").select(".node_module").attr("action") + "/update_platform_items/#{node_platform}"
      jQuery.ajax(url: update_platform_items_url, dataType: 'script')
  if $("input#node_module_configurable").prop("checked") == false
    $("#dependency_spec").hide()
    $("#node_module_dependency_spec").attr("disabled", "disabled")
  $("input#node_module_configurable")
    .change ->
      if $("input#node_module_configurable").prop("checked") == false
        $("#dependency_spec").slideUp()
        $("#node_module_dependency_spec").attr("disabled", "disabled")
      if $("input#node_module_configurable").prop("checked") == true
        $("#dependency_spec").slideDown()
        $("#node_module_dependency_spec").removeAttr("disabled")

$(document).bind 'show_node_modules.load', (e, obj) =>
  width = 800
  height = 400
  node_module_id = $("#node_module").data("id")
  color = d3.scale.category20()
  force = d3.layout.force().linkDistance(30).charge(-200).linkStrength(2).size([width, height])
  svg = d3.select("#dependency_tree")
    .append("svg")
    .attr("width", width)
    .attr("height", height)
  d3.json node_module_id + "/dependency_tree.json", (error, graph) ->
    nodes = graph.nodes.slice()
    links = []
    bilinks = []
    graph.links.forEach (link) ->
      s = nodes[link.source]
      t = nodes[link.target]
      i = {}
      nodes.push i
      links.push { source: s, target: i }, { source: i, target: t }
      bilinks.push [s, i, t]
    force.nodes(nodes).links(links).start()
    link = svg.selectAll(".link").data(bilinks).enter().append("path")
      .attr("class", "link")
    node = svg.selectAll(".node").data(graph.nodes).enter().append("g")
      .attr("class", "node")
      .call(force.drag)
    node.append("circle")
      .attr("r", 8)
      .style("fill", (d) -> color d.group)
    node.append("text")
      .attr("x", 10)
      .attr("dy", ".35em")
      .text((d) -> return d.name)
    force.on "tick", ->
      link.attr "d", (d) ->
        "M" + d[0].x + "," + d[0].y + "S" + d[1].x + "," + d[1].y + " " + d[2].x + "," + d[2].y
      node.attr "transform", (d) ->
        "translate(" + d.x + "," + d.y + ")"
  aspect =  width / height
  chart = $('#dependency_tree')
  $(window).on 'resize', ->
    targetWidth = chart.parent().width()
    chart.attr 'width', targetWidth
    chart.attr 'height', targetWidth / aspect
  $(window).resize()
